#: mailcraft-spam-ai@luff.biz/prefs.js:37
msgid "Connection"
msgstr "Anslutning"

#: mailcraft-spam-ai@luff.biz/prefs.js:42
msgid "MailCraft"
msgstr "MailCraft"

#: mailcraft-spam-ai@luff.biz/prefs.js:45
msgid "MailCraft must open its control channel. For the Flatpak, Set Up does this on every start; otherwise start it with: mailcraft --control <port> --control-agents-only"
msgstr "MailCraft måste öppna sin kontrollkanal. För Flatpak gör ”Ställ in” det vid varje start; starta den annars med: mailcraft --control <port> --control-agents-only"

#: mailcraft-spam-ai@luff.biz/prefs.js:48
msgid "Control Port"
msgstr "Kontrollport"

#: mailcraft-spam-ai@luff.biz/prefs.js:56
msgid "Open the Control Channel on Every Start"
msgstr "Öppna kontrollkanalen vid varje start"

#: mailcraft-spam-ai@luff.biz/prefs.js:59
#: mailcraft-spam-ai@luff.biz/prefs.js:393
msgid "Remove"
msgstr "Ta bort"

#: mailcraft-spam-ai@luff.biz/prefs.js:60
msgid "MailCraft no longer gets the two settings, also if they were set by hand"
msgstr "MailCraft får inte längre de två inställningarna, även om de satts för hand"

#: mailcraft-spam-ai@luff.biz/prefs.js:80
msgid "Only for the Flatpak of MailCraft. Otherwise start it with --control and the port."
msgstr "Bara för MailCraft som Flatpak. Starta den annars med --control och porten."

#: mailcraft-spam-ai@luff.biz/prefs.js:86
#, javascript-format
msgid "Set up: MailCraft opens port %d on every start, for agents only."
msgstr "Inställt: MailCraft öppnar port %d vid varje start, bara för agenter."

#: mailcraft-spam-ai@luff.biz/prefs.js:87
#: mailcraft-spam-ai@luff.biz/prefs.js:94
msgid "Set Up"
msgstr "Ställ in"

#: mailcraft-spam-ai@luff.biz/prefs.js:92
msgid "Not set up. MailCraft needs a restart afterwards."
msgstr "Inte inställt. MailCraft måste startas om efteråt."

#: mailcraft-spam-ai@luff.biz/prefs.js:93
#, javascript-format
msgid "Set up for port %d, not %d. MailCraft needs a restart afterwards."
msgstr "Inställt för port %d, inte %d. MailCraft måste startas om efteråt."

#: mailcraft-spam-ai@luff.biz/prefs.js:103
msgid "Done. Restart MailCraft to use it."
msgstr "Klart. Starta om MailCraft för att använda det."

#: mailcraft-spam-ai@luff.biz/prefs.js:105
#, javascript-format
msgid "Could not set up MailCraft: %s"
msgstr "Kunde inte ställa in MailCraft: %s"

#: mailcraft-spam-ai@luff.biz/prefs.js:113
#, javascript-format
msgid "Could not remove the setup: %s"
msgstr "Kunde inte ta bort inställningen: %s"

#: mailcraft-spam-ai@luff.biz/prefs.js:122
msgid "Language Model"
msgstr "Språkmodell"

#: mailcraft-spam-ai@luff.biz/prefs.js:126
msgid "Mail is only sent to the endpoint entered here, which is on this computer."
msgstr "E-post skickas bara till slutpunkten som anges här, och den finns på den här datorn."

#: mailcraft-spam-ai@luff.biz/prefs.js:128
msgid "Warning: this endpoint is not on this computer and the connection is not encrypted. The text of every checked mail is sent there."
msgstr "Varning: den här slutpunkten finns inte på den här datorn och anslutningen är inte krypterad. Texten i varje kontrollerat e-postmeddelande skickas dit."

#: mailcraft-spam-ai@luff.biz/prefs.js:129
msgid "This endpoint is not on this computer: the text of every checked mail is sent there."
msgstr "Den här slutpunkten finns inte på den här datorn: texten i varje kontrollerat e-postmeddelande skickas dit."

#: mailcraft-spam-ai@luff.biz/prefs.js:133
msgid "Kind of Endpoint"
msgstr "Typ av slutpunkt"

#: mailcraft-spam-ai@luff.biz/prefs.js:134
msgid "Ollama"
msgstr "Ollama"

#: mailcraft-spam-ai@luff.biz/prefs.js:134
msgid "OpenAI-compatible"
msgstr "OpenAI-kompatibel"

#: mailcraft-spam-ai@luff.biz/prefs.js:142
msgid "Address"
msgstr "Adress"

#: mailcraft-spam-ai@luff.biz/prefs.js:150
#: mailcraft-spam-ai@luff.biz/prefs.js:176
msgid "API Key (kept in the keyring)"
msgstr "API-nyckel (sparas i nyckelringen)"

#: mailcraft-spam-ai@luff.biz/prefs.js:159
msgid "MailCraft Spam AI API key"
msgstr "API-nyckel för MailCraft Spam AI"

#: mailcraft-spam-ai@luff.biz/prefs.js:161
msgid "API key saved"
msgstr "API-nyckel sparad"

#: mailcraft-spam-ai@luff.biz/prefs.js:163
#, javascript-format
msgid "Could not save the API key: %s"
msgstr "Kunde inte spara API-nyckeln: %s"

#: mailcraft-spam-ai@luff.biz/prefs.js:175
msgid "API Key (saved; enter a new one to replace it)"
msgstr "API-nyckel (sparad; ange en ny för att ersätta den)"

#: mailcraft-spam-ai@luff.biz/prefs.js:178
msgid "API Key (keyring not available)"
msgstr "API-nyckel (nyckelring inte tillgänglig)"

#: mailcraft-spam-ai@luff.biz/prefs.js:189
msgid "Model"
msgstr "Modell"

#: mailcraft-spam-ai@luff.biz/prefs.js:195
msgid "Load the models of the endpoint"
msgstr "Hämta slutpunktens modeller"

#: mailcraft-spam-ai@luff.biz/prefs.js:208
msgid "No model chosen"
msgstr "Ingen modell vald"

#: mailcraft-spam-ai@luff.biz/prefs.js:209
#, javascript-format
msgid "%s (not offered by the endpoint)"
msgstr "%s (erbjuds inte av slutpunkten)"

#: mailcraft-spam-ai@luff.biz/prefs.js:229
msgid "The endpoint offers no models"
msgstr "Slutpunkten erbjuder inga modeller"

#: mailcraft-spam-ai@luff.biz/prefs.js:235
#, javascript-format
msgid "Endpoint not reachable: %s"
msgstr "Slutpunkten kan inte nås: %s"

#: mailcraft-spam-ai@luff.biz/prefs.js:264
msgid "Filter"
msgstr "Filter"

#: mailcraft-spam-ai@luff.biz/prefs.js:268
#: mailcraft-spam-ai@luff.biz/lib/quickSettings.js:45
#: mailcraft-spam-ai@luff.biz/lib/quickSettings.js:56
msgid "Spam Filter"
msgstr "Skräppostfilter"

#: mailcraft-spam-ai@luff.biz/prefs.js:270
msgid "Spam Threshold"
msgstr "Skräppostgräns"

#: mailcraft-spam-ai@luff.biz/prefs.js:277
msgid "Every message will be moved to junk!"
msgstr "Alla meddelanden flyttas till skräppost!"

#: mailcraft-spam-ai@luff.biz/prefs.js:279
msgid "Very low: many good messages may be moved to junk."
msgstr "Mycket låg: många bra meddelanden kan hamna i skräppost."

#: mailcraft-spam-ai@luff.biz/prefs.js:280
msgid "Messages rated at or above this value (0–100) are moved to junk."
msgstr "Meddelanden med detta värde (0–100) eller högre flyttas till skräppost."

#: mailcraft-spam-ai@luff.biz/prefs.js:287
msgid "Check Every (Minutes)"
msgstr "Kontrollera var (minut)"

#: mailcraft-spam-ai@luff.biz/prefs.js:294
msgid "Longest Mail Text (Characters)"
msgstr "Längsta e-posttext (tecken)"

#: mailcraft-spam-ai@luff.biz/prefs.js:295
msgid "Longer mail is shortened before it is sent to the model."
msgstr "Längre e-post kortas innan den skickas till modellen."

#: mailcraft-spam-ai@luff.biz/prefs.js:303
msgid "Accounts"
msgstr "Konton"

#: mailcraft-spam-ai@luff.biz/prefs.js:304
msgid "With none chosen, every account is filtered."
msgstr "Om inget är valt filtreras alla konton."

#: mailcraft-spam-ai@luff.biz/prefs.js:309
msgid "Load the accounts from MailCraft"
msgstr "Hämta konton från MailCraft"

#: mailcraft-spam-ai@luff.biz/prefs.js:339
msgid "MailCraft not reachable"
msgstr "MailCraft kan inte nås"

#: mailcraft-spam-ai@luff.biz/prefs.js:356
msgid "Trusted Senders"
msgstr "Betrodda avsändare"

#: mailcraft-spam-ai@luff.biz/prefs.js:361
msgid "Never Check Mail From"
msgstr "Kontrollera aldrig e-post från"

#: mailcraft-spam-ai@luff.biz/prefs.js:364
msgid "People You Have Written To"
msgstr "Personer du har skrivit till"

#: mailcraft-spam-ai@luff.biz/prefs.js:365
msgid "Looked up in the Sent folder of the account."
msgstr "Slås upp i kontots mapp Skickat."

#: mailcraft-spam-ai@luff.biz/prefs.js:370
msgid "Your MailCraft Contacts"
msgstr "Dina MailCraft-kontakter"

#: mailcraft-spam-ai@luff.biz/prefs.js:377
msgid "Skip List"
msgstr "Undantagslista"

#: mailcraft-spam-ai@luff.biz/prefs.js:378
msgid "A full address (user@example.org) or a whole domain (@example.org)."
msgstr "En hel adress (user@example.org) eller en hel domän (@example.org)."

#: mailcraft-spam-ai@luff.biz/prefs.js:381
msgid "Add Address or Domain"
msgstr "Lägg till adress eller domän"

#: mailcraft-spam-ai@luff.biz/prefs.js:420
msgid "Log"
msgstr "Logg"

#: mailcraft-spam-ai@luff.biz/prefs.js:425
msgid "Last Checks"
msgstr "Senaste kontroller"

#: mailcraft-spam-ai@luff.biz/prefs.js:426
msgid "The last 100 checks. Kept only on this computer."
msgstr "De senaste 100 kontrollerna. Sparas bara på den här datorn."

#: mailcraft-spam-ai@luff.biz/prefs.js:429
msgid "Clear"
msgstr "Töm"

#: mailcraft-spam-ai@luff.biz/prefs.js:438
#, javascript-format
msgid "Error, given up and left in the inbox: %s"
msgstr "Fel, uppgivet och lämnat i inkorgen: %s"

#: mailcraft-spam-ai@luff.biz/prefs.js:439
#, javascript-format
msgid "Error, will try again: %s"
msgstr "Fel, försöker igen: %s"

#: mailcraft-spam-ai@luff.biz/prefs.js:442
msgid "Trusted sender, not checked"
msgstr "Betrodd avsändare, inte kontrollerad"

#: mailcraft-spam-ai@luff.biz/prefs.js:443
msgid "moved to junk"
msgstr "flyttad till skräppost"

#: mailcraft-spam-ai@luff.biz/prefs.js:443
msgid "left in the inbox"
msgstr "lämnad i inkorgen"

#: mailcraft-spam-ai@luff.biz/prefs.js:446
msgid "Trusted address, but the sender could not be verified, so it was checked."
msgstr "Betrodd adress, men avsändaren kunde inte bekräftas, så meddelandet kontrollerades."

#: mailcraft-spam-ai@luff.biz/prefs.js:453
msgid "Nothing checked yet"
msgstr "Inget kontrollerat ännu"

#: mailcraft-spam-ai@luff.biz/prefs.js:460
#: mailcraft-spam-ai@luff.biz/lib/quickSettings.js:142
msgid "(no subject)"
msgstr "(inget ämne)"

#: mailcraft-spam-ai@luff.biz/lib/quickSettings.js:37
msgid "Could not start MailCraft"
msgstr "Kunde inte starta MailCraft"

#: mailcraft-spam-ai@luff.biz/lib/quickSettings.js:61
msgid "Start MailCraft with Control Channel"
msgstr "Starta MailCraft med kontrollkanal"

#: mailcraft-spam-ai@luff.biz/lib/quickSettings.js:66
msgid "Check Now"
msgstr "Kontrollera nu"

#: mailcraft-spam-ai@luff.biz/lib/quickSettings.js:70
msgid "Recently Moved to Junk"
msgstr "Nyligen flyttade till skräppost"

#: mailcraft-spam-ai@luff.biz/lib/quickSettings.js:75
msgid "Spam Filter Settings"
msgstr "Inställningar för skräppostfilter"

#: mailcraft-spam-ai@luff.biz/lib/quickSettings.js:97
msgid "Off"
msgstr "Av"

#: mailcraft-spam-ai@luff.biz/lib/quickSettings.js:100
msgid "Checking the inbox…"
msgstr "Kontrollerar inkorgen …"

#: mailcraft-spam-ai@luff.biz/lib/quickSettings.js:103
msgid "MailCraft is not running with its control channel"
msgstr "MailCraft körs inte med sin kontrollkanal"

#: mailcraft-spam-ai@luff.biz/lib/quickSettings.js:106
#, javascript-format
msgid "Error: %s"
msgstr "Fel: %s"

#: mailcraft-spam-ai@luff.biz/lib/quickSettings.js:109
#, javascript-format
msgid "%d message moved today"
msgid_plural "%d messages moved today"
msgstr[0] "%d meddelande flyttat i dag"
msgstr[1] "%d meddelanden flyttade i dag"

#: mailcraft-spam-ai@luff.biz/lib/quickSettings.js:118
msgid "Needs attention"
msgstr "Kräver uppmärksamhet"

#: mailcraft-spam-ai@luff.biz/lib/quickSettings.js:119
#, javascript-format
msgid "%d moved today"
msgid_plural "%d moved today"
msgstr[0] "%d flyttat i dag"
msgstr[1] "%d flyttade i dag"

#: mailcraft-spam-ai@luff.biz/lib/quickSettings.js:137
msgid "Nothing moved yet"
msgstr "Inget flyttat ännu"
