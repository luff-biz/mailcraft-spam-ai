msgstr "Ne jamais vérifier le courrier de"

#: mailcraft-spam-ai@luff.biz/prefs.js:364
msgid "People You Have Written To"
msgstr "Personnes à qui vous avez écrit"

#: mailcraft-spam-ai@luff.biz/prefs.js:365
msgid "Looked up in the Sent folder of the account."
msgstr "Recherché dans le dossier Envoyés du compte."

#: mailcraft-spam-ai@luff.biz/prefs.js:370
msgid "Your MailCraft Contacts"
msgstr "Vos contacts MailCraft"

#: mailcraft-spam-ai@luff.biz/prefs.js:377
msgid "Skip List"
msgstr "Liste d’exceptions"

#: mailcraft-spam-ai@luff.biz/prefs.js:378
msgid "A full address (user@example.org) or a whole domain (@example.org)."
msgstr "Une adresse complète (user@example.org) ou un domaine entier (@example.org)."

#: mailcraft-spam-ai@luff.biz/prefs.js:381
msgid "Add Address or Domain"
msgstr "Ajouter une adresse ou un domaine"

#: mailcraft-spam-ai@luff.biz/prefs.js:420
msgid "Log"
msgstr "Journal"

#: mailcraft-spam-ai@luff.biz/prefs.js:425
msgid "Last Checks"
msgstr "Dernières vérifications"

#: mailcraft-spam-ai@luff.biz/prefs.js:426
msgid "The last 100 checks. Kept only on this computer."
msgstr "Les 100 dernières vérifications. Conservées uniquement sur cet ordinateur."

#: mailcraft-spam-ai@luff.biz/prefs.js:429
msgid "Clear"
msgstr "Effacer"

#: mailcraft-spam-ai@luff.biz/prefs.js:438
#, javascript-format
